# ── WordPress site ────────────────────────────────────────────────────────────
WP_URL=https://sanbornteam-ihf.mystagingwebsite.com

# WordPress admin credentials (use an Application Password, not your real password)
# Generate one at: WordPress Admin → Users → Profile → Application Passwords
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Staging / HTTP Basic Auth (if your staging site has an extra password layer) ──
# Leave blank if your site does not have HTTP auth
HTTP_AUTH_USER=
HTTP_AUTH_PASS=

# ── iHomeFinder / IMPress credentials (optional — used to cross-reference saved searches) ──
# Find these in WordPress Admin → iHomeFinder → Account
IHF_API_KEY=
IHF_PARTNER_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
